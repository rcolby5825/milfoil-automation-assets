<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Milfoil: Determine Scale</name>
  <id>org.milfoil.determine_scale</id>
  <param name="grid_size_mm" type="float" min="1.0" max="100.0" precision="2" gui-text="Real-world size of one grid square (document units, default mm)">25.4</param>
  <param name="force" type="bool" gui-text="Force scaling even when confidence check fails (not recommended — review results carefully)">false</param>
  <param name="venv_python" type="string" gui-text="Worker Python path (see INSTALL.md)">~/milfoil_env/bin/python3</param>
  <effect>
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Milfoil"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">milfoil_determine_scale.py</command>
  </script>
</inkscape-extension>
