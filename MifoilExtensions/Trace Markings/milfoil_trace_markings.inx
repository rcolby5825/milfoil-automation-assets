<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Milfoil: Trace Markings</name>
  <id>org.milfoil.trace_markings</id>
  <param name="label_prefix" type="string" gui-text="Source images whose label/ID starts with (try 'image' for un-labeled default imports)">src_</param>
  <param name="detect_circles" type="bool" gui-text="Detect dots/circles (reliable — on by default)">true</param>
  <param name="detect_grainline" type="bool" gui-text="Attempt grainline detection (experimental — verify results, often wrong on straight-sided pieces)">false</param>
  <param name="detect_arrows" type="bool" gui-text="Attempt arrowhead detection (experimental — verify results)">false</param>
  <param name="venv_python" type="string" gui-text="Worker Python path (see INSTALL.md)">~/milfoil_env/bin/python3</param>
  <effect>
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Milfoil"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">milfoil_trace_markings.py</command>
  </script>
</inkscape-extension>
